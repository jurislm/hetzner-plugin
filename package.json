{
  "name": "@jurislm/hetzner-plugin",
  "version": "2.1.2",
  "description": "Portable local stdio MCP plugin for Hetzner Cloud and Storage Box APIs",
  "type": "module",
  "bin": {
    "hetzner-plugin": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "assets",
    "plugin.json",
    "mcp.json",
    ".mcp.json",
    ".mcp.json.example",
    ".app.json.example",
    ".codex-plugin",
    "skills",
    "api",
    "openapi"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc",
    "start": "bun dist/index.js",
    "lint": "bun ./node_modules/eslint/bin/eslint.js src scripts --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "bun test",
    "api:fetch": "bun scripts/update-openapi.ts",
    "api:generate": "bun scripts/generate-openapi.ts",
    "api:check": "bun scripts/check-openapi.ts && bun run api:generate && git diff --exit-code -- openapi src/generated api/manifest.json",
    "manifest:check": "bun scripts/validate-plugin-manifests.ts",
    "package:check": "bun scripts/package-contents-check.ts",
    "release:test": "bun scripts/ci/test-release-pr-auto-merge.ts && bun scripts/ci/test-release-workflows.ts",
    "check": "bun run manifest:check && bun run api:check && bun run lint && bun run typecheck && bun run build && bun run test && bun run release:test && bun run package:check && bun pm pack --dry-run",
    "prepublishOnly": "bun run check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.4.2",
    "eslint": "10.11.0",
    "json-schema-to-zod": "2.8.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "yaml": "2.9.1"
  },
  "packageManager": "bun@1.3.14"
}
