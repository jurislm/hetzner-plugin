{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "hetzner-plugin",
  "version": "1.6.5",
  "description": "Portable Hetzner Cloud and Storage Box MCP plugin using local stdio tools generated from official OpenAPI contracts.",
  "author": {
    "name": "JurisLM",
    "url": "https://github.com/jurislm"
  },
  "homepage": "https://github.com/jurislm/hetzner-plugin",
  "repository": "https://github.com/jurislm/hetzner-plugin",
  "license": "MIT",
  "keywords": [
    "hetzner",
    "cloud",
    "storage-box",
    "devops",
    "mcp"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Hetzner",
        "shortDescription": "Manage Hetzner through agent tools.",
        "longDescription": "Inspect and control Hetzner Cloud and Storage Box resources through local stdio tools.",
        "developerName": "JurisLM",
        "category": "Developer tools",
        "capabilities": [
          "Read",
          "Write"
        ],
        "defaultPrompt": [
          "List my Hetzner Cloud servers."
        ],
        "composerIcon": "./assets/hetzner.png",
        "logo": "./assets/hetzner.png",
        "websiteURL": "https://github.com/jurislm/hetzner-plugin"
      }
    }
  }
}
